# SQLite database (default). For Supabase/Postgres, change prisma/schema.prisma
# datasource provider to "postgresql" and put your connection string here.
DATABASE_URL="file:./dev.db"

# Live voice tutor (OpenAI Realtime). Required for voice sessions.
OPENAI_API_KEY=sk-...
# Mini tier keeps ~1hr/day under the design's $50/mo budget (design doc §7).
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin

# Silent Evaluator + enrichment pipeline (Claude). Required for reasoning
# grading and for `pnpm enrich`.
ANTHROPIC_API_KEY=sk-ant-...
# Sonnet-tier evaluator per the design's budget; set claude-opus-5 for max rigor.
EVALUATOR_MODEL=claude-sonnet-5
ENRICH_MODEL=claude-opus-5
